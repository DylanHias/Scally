.DS_Store
.build/
build/
DerivedData/
*.xcuserstate
xcuserdata/
.remember/

# Generated by XcodeGen from project.yml - regenerate with `xcodegen generate`
Scally.xcodeproj/

# Feasibility probes only - hundreds of MB, never commit
Scally/Resources/SDUNet.mlpackage/
Scally/Resources/RSD4x.mlpackage/
Scally/Resources/VQ*.mlpackage/

# Diffusion models: 461MB, regenerated by the tools/ converters
ScallyKit/Sources/ScallyKit/Resources/RSD4x.mlpackage/
ScallyKit/Sources/ScallyKit/Resources/VQEncoder.mlpackage/
ScallyKit/Sources/ScallyKit/Resources/VQDecoder.mlpackage/

# Core ML models and source weights: hundreds of MB, and regenerable by the
# converters in tools/. GitHub rejects anything over 100 MB, and the fused
# diffusion weights alone are 333 MB.
ScallyKit/Sources/ScallyKit/Resources/*.mlpackage/
tools/*.safetensors
tools/*.pth
